# Lumen per-chat MCP sandbox image.
#
# First-run/developer build:
#   docker build --build-arg LUMEN_SANDBOX_VERSION=0.1.0-dev \
#     -f Dockerfile.sandbox -t lumen-sandbox .

FROM ubuntu:24.04

ARG LUMEN_SANDBOX_VERSION=dev
LABEL org.opencontainers.image.title="Lumen MCP Sandbox" \
      org.opencontainers.image.source="https://github.com/yossifibrahem/lumen-ai-chat" \
      org.opencontainers.image.version="${LUMEN_SANDBOX_VERSION}" \
      com.lumen.sandbox.version="${LUMEN_SANDBOX_VERSION}"

ENV DEBIAN_FRONTEND=noninteractive
ENV TZ=UTC

# Install Node.js inside Ubuntu for both MCP compilation and runtime. It also
# remains available for additional user-configured Node MCP servers.
RUN apt-get update && apt-get install -y --no-install-recommends \
        ca-certificates curl gnupg \
    && curl -fsSL https://deb.nodesource.com/gpgkey/nodesource-repo.gpg.key \
       | gpg --dearmor -o /usr/share/keyrings/nodesource.gpg \
    && printf 'Types: deb\nURIs: https://deb.nodesource.com/node_22.x\nSuites: nodistro\nComponents: main\nArchitectures: %s\nSigned-By: /usr/share/keyrings/nodesource.gpg\n' \
       "$(dpkg --print-architecture)" \
       > /etc/apt/sources.list.d/nodesource.sources \
    && apt-get update && apt-get install -y --no-install-recommends nodejs \
    && rm -rf /var/lib/apt/lists/*

RUN apt-get update && apt-get install -y --no-install-recommends \
    bash \
    bc \
    build-essential \
    coreutils \
    diffutils \
    dnsutils \
    file \
    findutils \
    git \
    grep \
    gzip \
    iputils-ping \
    jq \
    less \
    make \
    netcat-openbsd \
    openssl \
    patch \
    pkg-config \
    procps \
    python3 \
    python3-pip \
    python3-venv \
    sed \
    tar \
    unzip \
    wget \
    xz-utils \
    zip \
    && rm -rf /var/lib/apt/lists/*

RUN python3 -m venv /opt/venv
ENV PATH="/opt/venv/bin:$PATH"

RUN pip3 install --no-cache-dir uv \
    && python -m pip install --no-cache-dir \
        beautifulsoup4 \
        httpx \
        lxml \
        openpyxl \
        pandas \
        python-dotenv \
        requests

RUN npm install -g mcp-remote@0.1.38 \
    && npm cache clean --force

# Compile the bundled, pinned MCP source directly inside Ubuntu. npm's
# development dependencies and cache are created and removed in this same
# layer, so only the compiled server and production dependencies remain.
COPY vendor/computer-use-mcp-server/package.json \
     vendor/computer-use-mcp-server/package-lock.json \
     vendor/computer-use-mcp-server/tsconfig.json \
     /tmp/computer-use-mcp/
COPY vendor/computer-use-mcp-server/src /tmp/computer-use-mcp/src
RUN cd /tmp/computer-use-mcp \
    && npm ci \
    && npm run build \
    && npm prune --omit=dev \
    && npm install --no-save --package-lock=false --omit=dev \
        @modelcontextprotocol/sdk@1.30.0 \
        express@4.22.2 \
    && mkdir -p /opt/lumen/mcp/computer-use \
    && cp -R dist node_modules package.json /opt/lumen/mcp/computer-use/ \
    && cd / \
    && rm -rf /tmp/computer-use-mcp \
    && npm cache clean --force

WORKDIR /workspace
CMD ["sleep", "infinity"]
